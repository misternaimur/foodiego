# Copy this file to .env.local and fill in the values locally.
# UPDATE (production-deploy fix): this template was missing several
# variables the app now actually requires — most importantly BACKEND_URL
# and BACKEND_JWT_SECRET, whose absence is exactly why backend-proxied
# features (orders, favorites, addresses, chat) silently broke once
# deployed to Vercel (see src/lib/backend.ts's localhost fallback). Every
# variable below must be set in each Vercel project's own Environment
# Variables dashboard for a deployment to work — this file (and
# .env/.env.local) are never read by Vercel, they're local-dev-only.
GROQ_API_KEY=
GEMINI_API_KEY=
MONGODB_URL=mongodb://127.0.0.1:27017/FoodBackend

# Firebase Admin SDK credentials (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK configuration (public values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- foodiego-backend bridge (server-only) ---
# The deployed URL of the separate foodiego-backend Express project
# (e.g. https://foodiego-backend.vercel.app). Without this, the app falls
# back to http://localhost:8000, which doesn't exist in production.
BACKEND_URL=
# Must be byte-for-byte identical to foodiego-backend's own JWT_SECRET
# environment variable — this is what lets Next.js mint tokens that
# backend's `protect` middleware accepts.
BACKEND_JWT_SECRET=

# --- Cloudinary (server-only + one public value) ---
# Used for restaurant/menu-item/avatar image uploads. All three required —
# a missing CLOUDINARY_API_KEY silently breaks image uploads (they fail
# without throwing, so nothing appears to be wrong until you notice
# every new image ends up blank).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
